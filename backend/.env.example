# Copy this file to .env and fill in the values.

# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database: "sqlite", "mysql" (WAMP) or "postgresql"
# WAMP MySQL defaults: user root, empty password, port 3306
# PostgreSQL defaults: user postgres, port 5432
DB_ENGINE=mysql
DB_NAME=agri_shop
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# React dev server origin(s), comma separated
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT lifetimes
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# ---- Kisan Mandi Protection (escrow) ----
FRONTEND_URL=http://127.0.0.1:5173
# Days the buyer has to report a problem after delivery before money is released
PROTECTION_DAYS=3
# Unpaid orders are cancelled after this many minutes
PAYMENT_EXPIRY_MINUTES=30
SELLER_RESPONSE_HOURS=48
# Commission taken from each completed sale, in percent (0 = free)
PLATFORM_COMMISSION_PERCENT=0
# Test gateway for local development. MUST be False in production.
PAYMENT_TEST_MODE=True

# JazzCash merchant credentials (from the JazzCash merchant / sandbox portal).
# Paste them here only – never commit real values.
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_SANDBOX=True
JAZZCASH_RETURN_URL=http://127.0.0.1:8000/api/payments/jazzcash/return/

# Platform bank account shown to buyers who pay by bank transfer
PLATFORM_BANK_NAME=
PLATFORM_BANK_ACCOUNT_TITLE=
PLATFORM_BANK_ACCOUNT_NUMBER=
